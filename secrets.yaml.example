# Copy to secrets.yaml (gitignored) and fill in. If you build from the
# ESPHome dashboard / Home Assistant add-on, the same keys go in ITS
# secrets.yaml, which is a separate file shared by every device there.

# Shared with the other ESPHome devices on the network.
wifi_ssid: "YourNetwork"
wifi_password: "YourWiFiPassword"
# Your Olson timezone. The photoperiod and every displayed time use it.
timezone: "America/New_York"

# This project's own. Prefixed so they cannot collide with another device's
# keys in a shared secrets file. Used by both the controller and the panel.
lizard_monitor_ota_password: "change-me"
# Password for the fallback "<device> setup" access point (8+ characters).
lizard_monitor_ap_password: "change-me-too"
